# ─────────────────────────────────────────────────────────────────────
# v0-saas — variáveis de ambiente
#
# Copie este arquivo para .env.local e preencha os valores.
# .env.local NÃO é versionado (ver .gitignore).
# A tag [Xn] indica em qual bloco de implementação a variável passa a ser usada.
# ─────────────────────────────────────────────────────────────────────

# [A1] String de conexão Postgres (Neon).
#   Formato: postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require
#   Onde obter: painel do Neon -> seu projeto -> "Connection string".
#   Use a conexão DIRETA (sem "-pooler" no host) para a V0.
DATABASE_URL=

# [A4->C5] Alterna a UI entre dados mockados (true) e dados reais (false).
#   Começa em "true" (blocos A) e vira "false" no bloco C5.
USE_MOCK=true

# ── A partir daqui, chaves de blocos futuros. Deixe em branco por enquanto. ──

# [A2] Auth.js — segredo de assinatura da sessão JWT.
#   Gerar com:  openssl rand -base64 32
AUTH_SECRET=
# URL base da aplicação (usada por login e callbacks). Em desenvolvimento:
AUTH_URL=http://localhost:3000

# [B1] Google OAuth — UM client, usado em TRÊS fluxos mantidos separados:
#   (a) login da aplicação    -> scopes: openid email profile
#   (b) conexão de dados GA4   -> scope:  analytics.readonly  (offline)
#   (c) conexão do Google Ads  -> scope:  adwords             (offline)  [G2]
#   Onde obter: Google Cloud Console -> APIs & Services -> Credentials
#               -> OAuth 2.0 Client IDs -> tipo "Web application".
#   Redirect URIs a cadastrar no client:
#     http://localhost:3000/api/auth/callback/google       (login)
#     http://localhost:3000/api/oauth/ga4/callback          (GA4)
#     http://localhost:3000/api/oauth/google_ads/callback   (Google Ads) [G2]
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Redirect exclusivo do fluxo de dados GA4 (separado do redirect de login):
GA4_REDIRECT_URI=http://localhost:3000/api/oauth/ga4/callback

# [G2] Google Ads API. OPCIONAIS — sem elas o app sobe e o GA4 funciona; a
#   conexão do Google Ads existe mas a descoberta de contas falha com mensagem
#   clara. Ver docs/v1-architecture.md §10.1 e §13.
#   Developer token (Basic access) de uma conta Manager (MCC). Onde obter:
#   Google Ads (conta MCC) -> Tools -> API Center. Token novo nasce com
#   "Test account access" -> solicitar Basic access (formulário + revisão).
GOOGLE_ADS_DEVELOPER_TOKEN=
#   id do MCC (só dígitos, sem hífens) — usado no header login-customer-id ao
#   acessar uma conta-cliente via Manager. Deixe em branco para acesso direto.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# [B0] Chave para cifrar os tokens OAuth de terceiros em repouso (AES-256-GCM).
#   32 bytes em base64. Gerar com:  openssl rand -base64 32
APP_ENCRYPTION_KEY=

# [RD-1] RD Station Marketing. OPCIONAIS — sem elas o app sobe normal; só
#   conectar/sincronizar o Marketing falha, com mensagem clara.
#   Onde obter: App Publisher (appstore.rdstation.com/pt-BR/publisher) -> criar
#   app PRIVADO -> produto "RD Station Marketing".
#   Redirect URI a cadastrar no app (cole exatamente, sem barra final):
#     http://localhost:3000/api/oauth/rd_station_marketing/callback
RD_MARKETING_CLIENT_ID=
RD_MARKETING_CLIENT_SECRET=

# [RD-1] RD Station CRM — app SEPARADO do Marketing (produto diferente, mesmo
#   App Publisher). OPCIONAIS, mesma semântica acima.
#   Redirect URI a cadastrar no app:
#     http://localhost:3000/api/oauth/rd_station_crm/callback
RD_CRM_CLIENT_ID=
RD_CRM_CLIENT_SECRET=

# [Advisor] Liga/desliga o Advisor (padrão: true). O Advisor determinístico só lê
#   o diagnóstico e o Cross-source já calculados e não escreve nada. `false` esconde
#   a tela; o resto do produto (inclusive /diagnostico) não depende dele.
ADVISOR_ENABLED=true

# [Advisor LLM] Modelo de linguagem do Advisor — chave PRÓPRIA, padrão `false`.
#   Ligar o Advisor não liga o LLM. Desligado, ou sem credencial, o Advisor responde
#   só de forma determinística (e a tela diz isso). Ligado, o que sai para o
#   provedor é APENAS o contexto já calculado (sem PII: o payload é montado por
#   projeção explícita e varrido antes do envio); a resposta do modelo passa por
#   validação de schema e pelo guard, e se for recusada o sistema responde de forma
#   determinística. O LLM não calcula, não consulta o banco e não usa ferramentas.
ADVISOR_LLM_ENABLED=false
#   Credencial da API da Anthropic (https://platform.claude.com → API keys).
#   Fica só aqui (nunca no repositório, nunca em log). Vazio = ausente.
ANTHROPIC_API_KEY=
#   Opcionais (valores padrão entre parênteses):
#   ADVISOR_LLM_MODEL       modelo (claude-sonnet-5-5)
#   ADVISOR_LLM_EFFORT      low | medium | high — quanto o modelo pensa (medium)
#   ADVISOR_LLM_TIMEOUT_MS  tempo limite da chamada em ms, 5000–300000 (90000)
